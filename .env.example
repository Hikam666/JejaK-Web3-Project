# Database configuration (Supabase PostgreSQL)
# Gunakan Port 6543 dengan pgbouncer=true untuk Connection Pooling di Serverless/Vercel
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connect_timeout=20"
# Gunakan Port 5432 untuk Direct URL (migrasi prisma)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Supabase REST & Auth
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# BSC Testnet & Relayer Wallet
# Gunakan RPC resmi Binance Testnet yang stabil
BSC_TESTNET_RPC_URL="https://data-seed-prebsc-1-s1.bnbchain.org:8545"
RELAYER_PRIVATE_KEY="0x..."
RELAYER_ADDRESS="0x..."

# Smart Contract Address
NEXT_PUBLIC_CONTRACT_ADDRESS="0x764f397Bf9E54b534F9756ef897744F0B0D3De04"
